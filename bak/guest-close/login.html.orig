<!DOCTYPE html>
<html lang="bn">
<head>
    <script src="analytics.js" defer></script>
    <meta charset="UTF-8">
    <link rel="icon" type="image/png" href="images/favicon.png">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- SEO: এটা প্রাইভেট/ইউটিলিটি পেজ (প্রতিটা ইউজারের জন্য আলাদা ডেটা বা কোনো নির্দিষ্ট
         কনটেন্ট নেই) — তাই Google এটা ইনডেক্স না করুক, কিন্তু ভেতরের লিংকগুলো (যেমন প্রোডাক্ট
         লিংক) অনুসরণ করুক, এই জন্য noindex, follow ব্যবহার করা হলো -->
    <meta name="robots" content="noindex, follow">
    <title>লগইন - Smart Tech Zone</title>
    <link rel="stylesheet" href="style.css">
    <style>
.auth-container { --accent:#e74c3c; max-width:858px; margin:48px auto; padding:0 24px; }
.auth-welcome { display:flex; align-items:center; justify-content:space-between; gap:20px; margin-bottom:22px; }
.auth-welcome h1 { font-size:20px; font-weight:500; line-height:1.6; }
.auth-switch { flex-shrink:0; font-size:13px; color:#666; }
.auth-container a { color:#b83225; text-decoration:none; }
.auth-container a:hover { text-decoration:underline; }
.auth-card { background:#fff; border-radius:8px; padding:28px 32px 36px; box-shadow:0 2px 12px #0000000d; }
.auth-form-content { max-width:532px; margin:auto; }
.auth-card h2 { margin:0 0 22px; font-size:17px; font-weight:600; }
.auth-card label { display:block; font-size:13px; color:#333; }
.auth-card input { box-sizing:border-box; width:100%; height:46px; padding:11px 13px; margin-top:6px; border:1px solid #d5d7db; border-radius:4px; font:14px Arial,sans-serif; background:#fff; transition:border-color .2s,box-shadow .2s; }
.auth-card input::placeholder { color:#757575; }
.auth-card input:focus { outline:none; border-color:var(--accent); box-shadow:0 0 0 3px #e74c3c20; }
.password-label-row { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:24px; }
.auth-forgot { font-size:12px; text-align:right; }
.pw-wrap { position:relative; }
.pw-wrap input { padding-right:48px; }
.pw-toggle { position:absolute; right:2px; top:7px; width:44px; height:44px; display:grid; place-items:center; background:transparent; border:0; border-radius:4px; cursor:pointer; color:#666; }
.pw-toggle svg { width:21px; height:21px; }
.pw-toggle .eye-slash { display:none; }
.pw-toggle[aria-pressed="true"] .eye-slash { display:block; }
.auth-btn { width:100%; min-height:48px; margin-top:30px; background:var(--accent); color:#fff; border:0; font-family:inherit; font-size:15px; font-weight:600; border-radius:4px; cursor:pointer; transition:background .2s; }
.auth-btn:hover { background:#c0392b; }
.auth-btn:disabled,.fb-login-btn:disabled { opacity:.6; cursor:wait; }
.auth-container :is(button,a):focus-visible { outline:3px solid #b83225; outline-offset:3px; }
#authMsg { font-size:14px; text-align:center; overflow-wrap:anywhere; }
#authMsg:not(:empty) { margin-top:12px; }
.auth-divider { display:flex; align-items:center; gap:10px; margin:24px 0; color:#737373; font-size:13px; }
.auth-divider::before,.auth-divider::after { content:''; flex:1; height:1px; background:#e9e9ec; }
.social-login-row { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12px; align-items:center; }
#googleConfig { display:none; }
/* Google may briefly retain its HTML fallback alongside the personalized
   iframe. Reserve one row; keep the fallback until the iframe is visible. */
#googleSignInBtn { min-width:0; height:40px; overflow:hidden; display:flex; justify-content:center; }
#googleSignInBtn > div { flex-shrink:0; }
#googleSignInBtn.google-has-frame > div > div { display:none; }
#googleSignInBtn > div > iframe { position:relative !important; top:0 !important; }
.social-login-row { min-height:40px; }
.fb-login-btn { width:100%; height:40px; background:#fff; color:#333; border:1px solid #dadce0; border-radius:4px; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:9px; font:500 14px Arial,sans-serif; transition:background .2s,border-color .2s; }
.fb-login-btn:hover { background:#f3f7ff; border-color:#1877f2; }
@media(max-width:700px) { .auth-container { margin:32px auto; padding:0 16px; } .auth-welcome { flex-direction:column; gap:8px; text-align:center; } .auth-welcome h1 { font-size:19px; } .auth-card { padding:26px 22px 30px; } }
@media(max-width:380px) { .auth-card { padding-left:16px; padding-right:16px; } .social-login-row { gap:8px; } .auth-forgot { font-size:11px; } }
@media(prefers-reduced-motion:reduce) { .auth-container * { transition:none!important; } }
</style>
    <script src="config.js"></script>
    <script src="visitor-track.js" defer></script>
    <script src="customer-auth.js"></script>
    <script src="https://accounts.google.com/gsi/client" async defer></script>
</head>
<body>
    <div id="fb-root"></div>
    <script>
        // Facebook SDK লোড হওয়ার পর এই ফাংশনটা স্বয়ংক্রিয়ভাবে কল হয়
        window.fbAsyncInit = function() {
            FB.init({
                appId: '1736164367676120',
                cookie: true,
                xfbml: false,
                version: 'v21.0'
            });
        };
    </script>
    <script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_US/sdk.js"></script>

    <nav class="navbar">
        <a href="index.html" class="logo"><img src="images/logo.png" alt="Smart Tech Zone"></a>
        <div class="search-bar">
            <input type="text" placeholder="Search for parts...">
            <button>Search</button>
        </div>
        <div class="nav-icons">
            <span id="navAuthArea"><a href="login.html">Login</a></span>
            <a href="cart.html" class="stz-cart-link" title="কার্ট"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="stz-cart-icon-svg" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg><span id="cartCount" class="stz-cart-badge">0</span></a>
        </div>
    </nav>

    <main class="auth-container" aria-labelledby="welcomeTitle">
<div class="auth-welcome"><h1 id="welcomeTitle">Smart Tech Zone-এ স্বাগতম! অনুগ্রহ করে লগইন করুন।</h1><p class="auth-switch">নতুন কাস্টমার? <a id="registerLink" href="register.html">রেজিস্টার করুন</a></p></div>
        <div class="auth-card">
            <div class="auth-form-content"><h2>পাসওয়ার্ড দিয়ে লগইন করুন</h2>
            <form id="loginForm" autocomplete="on" onsubmit="event.preventDefault(); doLogin();">
                <label for="loginPhone">ফোন নম্বর অথবা ইমেইল*</label>
                <input type="text" id="loginPhone" name="username" autocomplete="username" autocapitalize="none" spellcheck="false" required placeholder="আপনার ফোন নম্বর অথবা ইমেইল">

                <div class="password-label-row"><label for="loginPassword">পাসওয়ার্ড*</label><a class="auth-forgot" id="forgotLink" href="forgot-password.html">পাসওয়ার্ড ভুলে গেছেন?</a></div>
                <div class="pw-wrap">
                    <input type="password" id="loginPassword" name="password" autocomplete="current-password" required placeholder="আপনার পাসওয়ার্ড">
                    <button type="button" class="pw-toggle" onclick="togglePassword('loginPassword', this)" aria-label="পাসওয়ার্ড দেখান" aria-pressed="false" aria-controls="loginPassword"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12Z"/><circle cx="12" cy="12" r="3"/><path class="eye-slash" d="m3 3 18 18"/></svg></button>
                </div>
            <button type="submit" class="auth-btn" id="loginBtn">লগইন করুন</button></form>
            <div id="authMsg" role="status" aria-live="polite" aria-atomic="true"></div>

            <div class="auth-divider">অথবা</div>
            <div class="social-login-row">
                <div id="googleConfig"
                     data-client_id="558401107682-uh42vi22bqerhsn08j7obr6cq0n480r1.apps.googleusercontent.com"
                     data-callback="handleGoogleCredentialResponse"
                     data-auto_prompt="false">
                </div>
                <div id="googleSignInBtn"
                     data-type="standard" data-size="large" data-theme="outline"
                     data-text="signin_with" data-shape="rectangular" data-logo_alignment="center" data-locale="en" data-width="260">
                </div>

                <button type="button" class="fb-login-btn" id="fbLoginBtn" onclick="handleFacebookLogin()">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="#1877f2" aria-hidden="true"><path d="M22 12.06C22 6.48 17.52 2 12 2S2 6.48 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.51 1.49-3.89 3.77-3.89 1.09 0 2.23.2 2.23.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.45 2.91h-2.33V22c4.78-.76 8.44-4.92 8.44-9.94z"/></svg>
                    Facebook
                </button>
            </div>

            </div>
        </div>
    </main>

    <div id="siteFooter"></div>
    <script src="footer.js"></script>
    <script src="search.js"></script>

    <script>
        const API_BASE = BACKEND_URL;

        function togglePassword(id, btn) {
            const input = document.getElementById(id);
            if (input.type === 'password') {
                input.type = 'text';
                btn.setAttribute('aria-pressed', 'true');
                btn.setAttribute('aria-label', 'পাসওয়ার্ড লুকান');
            } else {
                input.type = 'password';
                btn.setAttribute('aria-pressed', 'false');
                btn.setAttribute('aria-label', 'পাসওয়ার্ড দেখান');
            }
        }

        // চেকআউট থেকে ?redirect=checkout.html দিয়ে এলে লগইনের পর সরাসরি সেখানে ফেরত পাঠানো হয়
        const params = new URLSearchParams(window.location.search);
        const redirectTo = params.get('redirect') || 'account.html';
        document.getElementById('registerLink').href = `register.html?redirect=${encodeURIComponent(redirectTo)}`;
        document.getElementById('forgotLink').href = `forgot-password.html?redirect=${encodeURIComponent(redirectTo)}`;

        // ইতিমধ্যে লগইন করা থাকলে আর এই পেজে থাকার দরকার নেই
        if (getCustomerToken() && getCustomerData()) {
            window.location.href = redirectTo;
        }

        async function doLogin() {
            if (document.getElementById('loginBtn').disabled) return;
            if (!document.getElementById('loginForm').reportValidity()) return;
            const phone = document.getElementById('loginPhone').value.trim();
            const password = document.getElementById('loginPassword').value;
            const msg = document.getElementById('authMsg');
            const btn = document.getElementById('loginBtn');

            msg.textContent = '';

            if (!phone || !password) {
                msg.style.color = '#e74c3c';
                msg.textContent = 'ফোন নম্বর অথবা ইমেইল এবং পাসওয়ার্ড দুটোই দিন।';
                return;
            }

            btn.disabled = true;
            btn.textContent = 'লগইন হচ্ছে...';

            try {
                const res = await fetch(`${API_BASE}/api/customer-auth/login`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone, password })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'লগইন করা যায়নি।');

                setCustomerSession(data.token, data.customer);
                window.location.href = redirectTo;
            } catch (err) {
                msg.style.color = '#e74c3c';
                msg.textContent = '❌ ' + err.message;
            } finally {
                btn.disabled = false;
                btn.textContent = 'লগইন করুন';
            }
        }

        const googleButton = document.getElementById('googleSignInBtn');
        // Observe presentation only; this never re-renders the Google button.
        function syncGooglePresentation() {
            const iframe = googleButton.querySelector('iframe');
            const rect = iframe && iframe.getBoundingClientRect();
            googleButton.classList.toggle('google-has-frame', Boolean(rect && rect.width > 0 && rect.height > 0));
        }
        new MutationObserver(syncGooglePresentation).observe(googleButton, {
            childList: true, subtree: true, attributes: true, attributeFilter: ['style']
        });
        let googleInitialized = false;
        let googleButtonWidth = 0;
        function resizeGoogleButton() {
            if (!window.google?.accounts?.id) return;
            const width = Math.floor(googleButton.getBoundingClientRect().width);
            // Google changes its contents after rendering/personalization. Only
            // rebuild for a real column-width change, never a height change.
            if (width <= 0 || width === googleButtonWidth) return;
            if (!googleInitialized) {
                google.accounts.id.initialize({
                    client_id: document.getElementById('googleConfig').dataset.client_id,
                    callback: handleGoogleCredentialResponse, auto_select: false
                });
                googleInitialized = true;
            }
            googleButtonWidth = width;
            googleButton.classList.remove('google-has-frame');
            googleButton.replaceChildren();
            google.accounts.id.renderButton(googleButton, {
                type: 'standard', theme: 'outline', size: 'large', text: 'signin_with',
                shape: 'rectangular', logo_alignment: 'center', locale: 'en', width
            });
        }
        window.addEventListener('load', resizeGoogleButton);
        let googleResizeTimer;
        // Only viewport resizing can request another render. Google changing
        // its own markup must never trigger a render feedback loop.
        window.addEventListener('resize', () => {
            clearTimeout(googleResizeTimer);
            googleResizeTimer = setTimeout(resizeGoogleButton, 150);
        });

        // Google-এর "Sign in with Google" বাটনে ক্লিক করলে গুগল নিজে থেকেই এই ফাংশনটা কল করে,
        // একটা যাচাইকৃত ID টোকেন (credential) সহ — সেটা ব্যাকএন্ডে পাঠিয়ে লগইন/অ্যাকাউন্ট তৈরি হচ্ছে
        async function handleGoogleCredentialResponse(response) {
            const msg = document.getElementById('authMsg');
            msg.style.color = '#333';
            msg.textContent = 'লগইন হচ্ছে...';
            try {
                const res = await fetch(`${API_BASE}/api/customer-auth/google`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ credential: response.credential })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Google লগইন ব্যর্থ হয়েছে।');

                setCustomerSession(data.token, data.customer);
                window.location.href = redirectTo;
            } catch (err) {
                msg.style.color = '#e74c3c';
                msg.textContent = '❌ ' + err.message;
            }
        }

        // Facebook-এর বাটনে ক্লিক করলে FB.login() একটা পপআপ খোলে, ইউজার অনুমতি দিলে
        // একটা accessToken পাওয়া যায় — সেটা ব্যাকএন্ডে পাঠিয়ে যাচাই করিয়ে লগইন/অ্যাকাউন্ট তৈরি হয়
        function handleFacebookLogin() {
            const msg = document.getElementById('authMsg');
            if (typeof FB === 'undefined') {
                msg.style.color = '#e74c3c';
                msg.textContent = 'Facebook এখনো লোড হয়নি, একটু পর আবার চেষ্টা করুন।';
                return;
            }
            FB.login(function(response) {
                if (response.authResponse) {
                    msg.style.color = '#333';
                    msg.textContent = 'লগইন হচ্ছে...';
                    facebookLoginToBackend(response.authResponse.accessToken);
                } else {
                    msg.style.color = '#e74c3c';
                    msg.textContent = 'Facebook লগইন বাতিল করা হয়েছে।';
                }
            }, { scope: 'email' });
        }

        async function facebookLoginToBackend(accessToken) {
            const msg = document.getElementById('authMsg');
            try {
                const res = await fetch(`${API_BASE}/api/customer-auth/facebook`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ accessToken })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Facebook লগইন ব্যর্থ হয়েছে।');

                setCustomerSession(data.token, data.customer);
                window.location.href = redirectTo;
            } catch (err) {
                msg.style.color = '#e74c3c';
                msg.textContent = '❌ ' + err.message;
            }
        }
    </script>
</body>
</html>
